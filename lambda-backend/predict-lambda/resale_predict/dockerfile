# Use AWS Lambda Python 3.10 base image
FROM public.ecr.aws/lambda/python:3.10

# Copy requirements.txt and install dependencies
COPY requirements.txt .
RUN python3.10 -m pip install --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt -t "${LAMBDA_TASK_ROOT}"

# Copy your Lambda function code and model
COPY app.py ${LAMBDA_TASK_ROOT}/
COPY xgb_model.json ${LAMBDA_TASK_ROOT}/
COPY categorical_info.json ${LAMBDA_TASK_ROOT}/

# Set the CMD to your handler (app.lambda_handler)
CMD ["app.lambda_handler"]
